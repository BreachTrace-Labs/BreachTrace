# BreachTrace — Environment Variables
# Copy this file to .env and fill in real values before running the backend.

# ── AWS Admin (for CloudTrail queries) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ── AWS Experiment User (read-only; this key gets "leaked" in tests) ────────────
EXPERIMENT_AWS_ACCESS_KEY_ID=AKIA...
EXPERIMENT_AWS_SECRET_ACCESS_KEY=...

# ── GCP Admin Service Account (for Cloud Audit Log queries) ────────────────────
# Paste the FULL JSON key string (not a file path) from a service account with
# roles: Logging Viewer + Project Viewer on your GCP project.
GCP_PROJECT_ID=your-project-id
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"breachtrace-admin@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── GCP Experiment Service Account (the "leaked" credential) ───────────────────
# This is the SA whose activity gets traced. Should have minimal permissions
# (e.g. Storage Object Viewer) so it actually generates audit log entries.
GCP_EXPERIMENT_CLIENT_EMAIL=breachtrace-experiment@your-project-id.iam.gserviceaccount.com
GCP_EXPERIMENT_PRIVATE_KEY_ID=<40-char hex key ID from the experiment SA JSON key>
GCP_EXPERIMENT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n

# ── Azure Admin App Registration (for Activity Log queries) ────────────────────
# App must have: Log Analytics Reader + Reader roles on the subscription.
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=<admin-app-client-secret>
AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Azure Experiment App Registration (the "leaked" credential) ────────────────
# This is the app whose activity gets traced. Should have minimal permissions
# (e.g. Storage Blob Data Reader) so it generates Activity Log entries.
AZURE_EXPERIMENT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_EXPERIMENT_CLIENT_SECRET=<experiment-app-client-secret>

# ── GitHub ──────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=<random-32-char-string>
GITHUB_TEST_REPO=yourusername/breachtrace-test-repo

# ── Gemini ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=...

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/breachtrace

# ── App ─────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
